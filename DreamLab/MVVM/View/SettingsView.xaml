<UserControl x:Class="DreamLab.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#38344F">

    <StackPanel Margin="20">
        <TextBlock Text="Ustawienia klawiszy (Keybinds)" 
                   Foreground="White" FontSize="20" Margin="0,0,0,20"/>

        <UniformGrid Columns="2" Rows="3">
            <TextBlock Text="Start gry:" Foreground="White" VerticalAlignment="Center"/>
            <TextBox Text="Spacja" Margin="5"/>

            <TextBlock Text="Kolory:" Foreground="White" VerticalAlignment="Center"/>
            <TextBox Text="A" Margin="5"/>

            <TextBlock Text="Pedały:" Foreground="White" VerticalAlignment="Center"/>
            <TextBox Text="P" Margin="5"/>
        </UniformGrid>
    </StackPanel>
</UserControl>
